# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/agrivet_booking?schema=public"

# Security — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET="change-me-to-a-long-random-string-in-production"
ACCESS_TOKEN_TTL="15m"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Resend (email delivery — backend only, never exposed to frontend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Sender must be a verified domain or onboarding@resend.dev (testing only)
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Agrivet Supply"

# Email verification token lifetime
EMAIL_VERIFICATION_TTL="60m"

# Public base URL used to build verification links in emails
PUBLIC_BASE_URL="http://localhost:4000"

# Seed (bootstrap SUPER_ADMIN)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@agrivet.local"
SEED_ADMIN_PASSWORD="StrongPass!2026"