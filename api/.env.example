# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/agrivet_booking?schema=public"

# Security — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET="change-me-to-a-long-random-string-in-production"
ACCESS_TOKEN_TTL="15m"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006"

# Gmail SMTP (email delivery — backend only, never exposed to frontend)
# Use a Google App Password, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2FA required).
NODEMAIL_USER="your-gmail@gmail.com"
NODEMAIL_PASS="your-16-character-gmail-app-password"
NODEMAIL_FROM_NAME="Agrivet Supply"
# Optional SMTP overrides (defaults: smtp.gmail.com:587, STARTTLS)
# NODEMAIL_HOST="smtp.gmail.com"
# NODEMAIL_PORT="587"
# NODEMAIL_SECURE="false"
# NODEMAIL_REQUIRE_TLS="true"

# Email verification code lifetime / attempts
EMAIL_VERIFICATION_TTL="10m"

# Seed (bootstrap SUPER_ADMIN)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@agrivet.local"
SEED_ADMIN_PASSWORD="StrongPass!2026"