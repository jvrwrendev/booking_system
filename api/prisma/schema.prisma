generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  BRANCH
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
  ORDER_COMMIT
  ORDER_RELEASE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ASSIGNED
  ADMIN_ACCEPTED
  REVIEW_ORDER
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  READY_FOR_DELIVERY
  CANCELLED
  REJECTED
}

enum BranchOrderStatus {
  PENDING
  ACCEPTED
  ASSIGNED
  ADMIN_ACCEPTED
  REVIEW_ORDER
  PROCESSING
  READY
  COMPLETED
  READY_FOR_DELIVERY
  REJECTED
}

model User {
  id                            String                  @id @default(cuid())
  name                          String
  email                         String                  @unique
  passwordHash                  String
  role                          Role
  status                        AccountStatus           @default(ACTIVE)
  emailVerified                 DateTime?               @map("email_verified")
  contactNumber                 String?
  address                       String?
  avatar                        String?
  agentId                       String?                 @unique
  branchId                      String?                 @unique
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  sessions                      Session[]
  verificationCodes             EmailVerificationCode[]
  inventoryTransactions         InventoryTransaction[]
  assignedBookings              Booking[]               @relation("BookingAssignedAdmin")
  assignedBookingActions        Booking[]               @relation("BookingAssignedBy")
  assignedBranchOrders          BranchOrder[]           @relation("BranchOrderAssignedAdmin")
  assignedBranchOrderActions    BranchOrder[]           @relation("BranchOrderAssignedBy")

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?   @db.VarChar(45)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("email_verification_codes")
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]

  @@map("categories")
}

model Branch {
  id           String                 @id
  name         String
  code         String?                @unique
  status       BranchStatus           @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inventory    InventoryStock[]
  transactions InventoryTransaction[]
  bookings     Booking[]
  branchOrders BranchOrder[]

  @@map("branches")
}

model Supplier {
  id            String         @id @default(cuid())
  name          String         @unique
  contactName   String?
  contactNumber String?
  address       String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]

  @@index([status])
  @@map("suppliers")
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  sku               String                 @unique
  categoryId        String?
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplierRef       Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brand             String?
  description       String?
  unit              String
  costPrice         Decimal                @db.Decimal(12, 2)
  sellingPrice      Decimal                @db.Decimal(12, 2)
  stockQuantity     Int                    @default(0)
  minimumStockLevel Int                    @default(0)
  supplier          String?
  status            ProductStatus          @default(ACTIVE)
  stockStatus       StockStatus            @default(OUT_OF_STOCK)
  image             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  inventory         InventoryStock[]
  transactions      InventoryTransaction[]
  bookingItems      BookingItem[]
  branchOrderItems  BranchOrderItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@map("products")
}

model InventoryStock {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentStock  Int         @default(0)
  reservedStock Int         @default(0)
  minimumStock  Int         @default(0)
  status        StockStatus @default(OUT_OF_STOCK)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([status])
  @@map("inventory_stocks")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  productId       String
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type            InventoryTransactionType
  quantity        Int
  previousStock   Int
  newStock        Int
  reason          String
  performedById   String?
  performedBy     User?                    @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedByName String
  referenceType   String?
  referenceId     String?
  createdAt       DateTime                 @default(now())

  @@unique([referenceType, referenceId, productId, type])
  @@index([productId, createdAt])
  @@index([branchId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model Booking {
  id                String                 @id @default(cuid())
  reference         String                 @unique
  customerId        String?
  customerName      String
  customerContact   String?
  customerAddress   String?
  agentId           String?
  agentName         String
  branchId          String
  branch            Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchName        String
  bookingDate       DateTime
  pickupDate        DateTime
  subtotal          Decimal                @db.Decimal(12, 2)
  discount          Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal                @db.Decimal(12, 2)
  status            BookingStatus          @default(PENDING)
  notes             String?
  assignedAdminId   String?
  assignedAdmin     User?                  @relation("BookingAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminName String?
  assignedById      String?
  assignedBy        User?                  @relation("BookingAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedByName    String?
  assignmentDate    DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             BookingItem[]
  statusHistory     BookingStatusHistory[]

  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([agentId, createdAt])
  @@index([assignedAdminId])
  @@index([bookingDate])
  @@map("bookings")
}

model BookingItem {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([productId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  label      String
  byName     String
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model BranchOrder {
  id                  String                     @id @default(cuid())
  reference           String                     @unique
  branchId            String
  branch              Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchName          String
  branchManager       String?
  branchContact       String?
  branchAddress       String?
  orderDate           DateTime
  subtotal            Decimal                    @db.Decimal(12, 2)
  discount            Decimal                    @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal                    @db.Decimal(12, 2)
  status              BranchOrderStatus          @default(PENDING)
  notes               String?
  assignedAdminId     String?
  assignedAdmin       User?                      @relation("BranchOrderAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminName   String?
  assignedById        String?
  assignedBy          User?                      @relation("BranchOrderAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedByName      String?
  assignmentDate      DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  items               BranchOrderItem[]
  statusHistory       BranchOrderStatusHistory[]

  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([assignedAdminId])
  @@index([orderDate])
  @@map("branch_orders")
}

model BranchOrderItem {
  id            String      @id @default(cuid())
  branchOrderId String
  branchOrder   BranchOrder @relation(fields: [branchOrderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  sku           String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@index([branchOrderId])
  @@index([productId])
  @@map("branch_order_items")
}

model BranchOrderStatusHistory {
  id            String             @id @default(cuid())
  branchOrderId String
  branchOrder   BranchOrder        @relation(fields: [branchOrderId], references: [id], onDelete: Cascade)
  fromStatus    BranchOrderStatus?
  toStatus      BranchOrderStatus
  label         String
  byName        String
  createdAt     DateTime           @default(now())

  @@index([branchOrderId, createdAt])
  @@map("branch_order_status_history")
}
