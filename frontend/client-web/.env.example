# Agent location map
# The map uses MapLibre GL with raster tiles. No API key is required.
#
# Base layers:
#   Satellite - Esri World Imagery (default)
#   Map       - OpenStreetMap standard tiles
#
# Both default endpoints are fine for development and low volume only.
# Before production, point these at imagery you are licensed for
# (self-hosted tiles or a commercial provider). Placeholders must be
# {z}/{x}/{y} for street and {z}/{y}/{x} for Esri-style services.
# VITE_SATELLITE_TILE_URL=""
# VITE_STREET_TILE_URL=""

# API
# In development the app calls same-origin "/api/v1/..." and the Vite dev
# server proxies it to http://localhost:4000 (see vite.config.ts). That keeps
# the httpOnly session cookie working without CORS or SameSite=None, so you do
# not normally need to set anything here.
#
# Set this ONLY to bypass the proxy, e.g. when the API is on a different host.
# Cross-origin then requires the API to allow this origin via CORS and to send
# the cookie with SameSite=None; Secure is required over HTTPS.
# VITE_API_BASE_URL="http://localhost:4000/api/v1"

# Development convenience only. Pre-fills the login email and shows the
# "development account" hint. Never set a password here, and drop this in any
# deployed build.
# VITE_DEV_ADMIN_EMAIL="admin@agrivet.local"
